# Core Database & Cache
DATABASE_URL=postgresql://matrimony:matrimony_dev@127.0.0.1:5432/matrimony
REDIS_URL=redis://127.0.0.1:6379

# App URL & Session Secret (change AUTH_SECRET to 32+ random chars in prod)
APP_URL=http://localhost:3000
AUTH_SECRET=change-this-to-a-32-char-random-production-secret

# Media Storage: "local" for dev, "r2" for Cloudflare R2
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=matrimony-media
# R2_PUBLIC_URL=https://cdn.example.vn

# Google OAuth 2.0 (optional in local dev; Email OTP works without it)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Email OTP via Resend (optional in local dev; OTP prints to server console if unset)
# RESEND_API_KEY=
# EMAIL_FROM=Matrimony <noreply@example.vn>

# Gemini Flash AI Copywriter (Phase 0 Day 8-10)
# GEMINI_API_KEY=

# PayOS / SePay Webhook (Phase 0 Day 15-17)
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
